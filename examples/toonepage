#!/bin/sh

usage () {
  cat << EOF
usage: toonepage <pddpsource>.xml
EOF
  exit $1
}

[ $# -eq 0 ] && usage 1

infile="$1"

SOURCE_NAME="$(basename "${infile}")"
SOURCE_STUB="$(basename "${SOURCE_NAME}" .xml)"

[ "${SOURCE_STUB}" = "${SOURCE_NAME}" ] && usage 1

xmllint >/dev/null --xinclude --postvalid "${infile}"
xsltproc --nonet --xinclude \
 --stringparam html.stylesheet pddp.css \
 -o "$SOURCE_STUB.html" \
 /usr/share/xml/docbook/stylesheet/nwalsh/html/docbook.xsl \
 "${infile}"
